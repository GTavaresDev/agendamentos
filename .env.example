# Copie para .env e preencha. NUNCA coloque valores reais neste arquivo.

# Banco de dados (Postgres)
DATABASE_URL=

# Segredo do Auth.js — assina os cookies de sessão da equipe e do portal.
# Gere um novo com: npx auth secret
AUTH_SECRET=

# Google OAuth do portal do cliente (Google Cloud Console → Credentials)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# E-mail transacional (Gmail SMTP) — link de redefinição de senha do portal
# GMAIL_APP_PASSWORD é gerada em myaccount.google.com/apppasswords (exige
# verificação em duas etapas ativada na conta).
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Acesso administrativo interno
MASTER_ADMIN_USER_ID=
MASTER_ADMIN_PASSWORD=
SALE_EDIT_PASSWORD=

# Cache Redis (Upstash) — OPCIONAL.
# Em branco, o app funciona normalmente e lê tudo direto do Postgres.
# Escolha a região mais perto do banco: um Redis distante custa a mesma ida e
# volta que a consulta que ele deveria evitar.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
